' Start pxlite without a console window. Safe to run twice: a second copy
' exits at once because the port is already taken.
' Generated by `pxlite setup autostart` from templates/start-hidden.vbs.
Set sh = CreateObject("WScript.Shell")
sh.Run "node --max-old-space-size=512 ""@@PXLITE_MJS@@"" serve", 0, False
