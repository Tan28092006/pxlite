' Launch OpenCode desktop behind pxlite (HTTPS_PROXY + pxpipe CA for this app only).
' OpenCode keeps a background service (opencode-cli serve --service); it only picks up
' these variables if OpenCode is fully closed before this launcher runs.
' Generated by `pxlite setup opencode` from templates/opencode-pxlite.vbs.
Set sh = CreateObject("WScript.Shell")
home = sh.ExpandEnvironmentStrings("%USERPROFILE%")
local = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%")

Set wmi = GetObject("winmgmts:\\.\root\cimv2")
If wmi.ExecQuery("SELECT ProcessId FROM Win32_Process WHERE Name='OpenCode.exe'").Count > 0 Then
  MsgBox "OpenCode dang mo." & vbCrLf & "Hay dong OpenCode (ca icon o khay), roi mo lai shortcut nay.", vbExclamation, "OpenCode (pxlite)"
  WScript.Quit 1
End If
' The app is closed but its background service outlives it and keeps the old
' environment. Offer to stop it so the app restarts it with the proxy variables.
Set svc = wmi.ExecQuery("SELECT ProcessId FROM Win32_Process WHERE Name='opencode-cli.exe'")
If svc.Count > 0 Then
  answer = MsgBox("Dich vu nen cua OpenCode (opencode-cli serve) van dang chay sau khi da dong app." & vbCrLf & _
    "Tat no de mo lai OpenCode qua pxlite?" & vbCrLf & vbCrLf & _
    "Viec OpenCode dang chay ngam (neu co) se bi dung.", vbYesNo + vbQuestion, "OpenCode (pxlite)")
  If answer <> vbYes Then WScript.Quit 1
  For Each p In svc
    p.Terminate
  Next
  WScript.Sleep 1500
End If

sh.Run "wscript ""@@START_VBS@@""", 0, True
WScript.Sleep 2000

Set env = sh.Environment("PROCESS")
env("HTTPS_PROXY") = "@@PROXY_URL@@"
env("NODE_EXTRA_CA_CERTS") = "@@CA_BUNDLE@@"
sh.Run """" & local & "\Programs\ai.opencode.desktop\OpenCode.exe""", 1, False
